{
  "name": "@gofastr/richtext-editor-bundle",
  "private": true,
  "version": "0.0.0-dev",
  "description": "In-frame ProseMirror editor bundle for the GoFastr Rich Text plugin. Builds a single IIFE that runs inside the opaque-origin sandboxed iframe and speaks protocol v1 to the host over postMessage.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "markdown-it": "14.2.0",
    "prosemirror-commands": "1.6.2",
    "prosemirror-dropcursor": "1.8.1",
    "prosemirror-gapcursor": "1.3.2",
    "prosemirror-history": "1.4.1",
    "prosemirror-inputrules": "1.4.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.0",
    "prosemirror-model": "1.24.1",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.3",
    "prosemirror-tables": "1.6.4",
    "prosemirror-transform": "1.10.2",
    "prosemirror-view": "1.37.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "esbuild": "0.25.0",
    "typescript": "^7.0.2"
  }
}
